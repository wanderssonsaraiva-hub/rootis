# Banco Neon (somente servidor/Vercel; nunca coloque isso no script.js)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Segredo usado para proteger códigos temporários
ROOTIS_OTP_SECRET=troque-por-uma-chave-longa-aleatoria

# Bootstrap inicial do proprietário (use apenas localmente para executar npm run create-admin)
ROOTIS_ADMIN_EMAIL=seu-email-de-administrador
ROOTIS_ADMIN_PHONE=seu-celular-de-recuperacao
ROOTIS_ADMIN_PASSWORD=sua-senha-forte
ROOTIS_ADMIN_NAME=Administrador Rootis

# E-mail de verificação (Resend)
RESEND_API_KEY=
ROOTIS_EMAIL_FROM=Rootis <acesso@rootis.com.br>

# SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# SOMENTE desenvolvimento. Nunca habilite em produção.
ROOTIS_ALLOW_TEST_OTP=false
